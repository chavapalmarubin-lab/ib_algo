# Copy this file to ".env" and edit. NEVER commit .env (it's gitignored).
IB_HOST=127.0.0.1
IB_PORT=7497              # 7497 = TWS paper (default) · 4002 = IB Gateway paper
IB_CLIENT_ID=11
IB_EXECUTION_ENABLED=0    # keep 0 until a strategy is proven on paper for weeks
# IB_ALLOW_LIVE=1         # ONLY uncomment when you knowingly move to real money

# Risk caps (used once execution is on)
IB_RISK_PER_TRADE=0.01
IB_MAX_POSITION_PCT=0.10

# Telegram alerts (optional — fill in later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
